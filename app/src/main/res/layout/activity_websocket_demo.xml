<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 连接控制区 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WebSocket Topic 路由演示"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_server_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ws://10.0.2.2:8080/ws"
            android:inputType="textUri"
            android:text="ws://10.0.2.2:8080/ws"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="连接"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_disconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="断开"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_connection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态: 未连接"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 聊天频道 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💬 聊天频道 (chat)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂无消息"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:minHeight="60dp"
            android:layout_marginBottom="8dp" />

        <!-- 通知频道 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔 通知频道 (notification)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂无通知"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:minHeight="60dp"
            android:layout_marginBottom="8dp" />

        <!-- 协同编辑频道 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 协同编辑频道 (collaboration)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_collab_events"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂无事件"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:minHeight="60dp"
            android:layout_marginBottom="8dp" />

        <!-- 在线状态频道 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 在线状态频道 (presence)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_online_users"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂无在线用户"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:minHeight="60dp"
            android:layout_marginBottom="16dp" />

        <!-- 模拟消息按钮（用于演示） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模拟接收消息（演示用）"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_sim_chat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="模拟聊天"
                android:textSize="12sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btn_sim_notification"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="模拟通知"
                android:textSize="12sp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_sim_collab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="模拟协同"
                android:textSize="12sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btn_sim_presence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="模拟在线"
                android:textSize="12sp"
                android:layout_marginStart="2dp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
